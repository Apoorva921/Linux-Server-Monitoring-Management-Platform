# ==============================================================================
# SentinelOps - Environment Configuration
# Copy this file to .env and update secrets before deploying to production.
# ==============================================================================

# --- Application ---
APP_NAME=SentinelOps
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-strong-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,http://localhost

# --- Database (PostgreSQL) ---
POSTGRES_USER=sentinelops
POSTGRES_PASSWORD=sentinelops_dev_password
POSTGRES_DB=sentinelops
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://sentinelops:sentinelops_dev_password@postgres:5432/sentinelops

# --- Initial Admin Bootstrap (created on first startup if no users exist) ---
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@sentinelops.local
INITIAL_ADMIN_PASSWORD=Admin@SentinelOps123!

# --- Monitoring & Alerting Defaults ---
DEFAULT_MONITORING_INTERVAL_SECONDS=5
SERVER_OFFLINE_THRESHOLD_SECONDS=30
DEFAULT_METRIC_RETENTION_DAYS=30
RATE_LIMIT_AUTH_PER_MINUTE=20

# --- Frontend ---
VITE_API_BASE_URL=/api
VITE_WS_URL=

# --- Demo Mode Simulator ---
DEMO_MODE=false
DEMO_API_URL=http://backend:8000
DEMO_INTERVAL_SECONDS=5

# --- Monitoring Agent (for Linux hosts) ---
SENTINELOPS_API_URL=http://localhost:8000
SENTINELOPS_SERVER_ID=
SENTINELOPS_API_TOKEN=
SENTINELOPS_INTERVAL_SECONDS=5
SENTINELOPS_LOG_SOURCES=/var/log/syslog,/var/log/auth.log
SENTINELOPS_ENABLE_JOURNALCTL=true

