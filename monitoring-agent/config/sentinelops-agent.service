[Unit]
Description=SentinelOps Linux Monitoring Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sentinelops
Group=sentinelops
SupplementaryGroups=adm systemd-journal
WorkingDirectory=/opt/sentinelops-agent
EnvironmentFile=/etc/sentinelops/agent.env
ExecStart=/opt/sentinelops-agent/.venv/bin/python /opt/sentinelops-agent/agent.py
Restart=always
RestartSec=5

# Least-privilege systemd hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/log

[Install]
WantedBy=multi-user.target

