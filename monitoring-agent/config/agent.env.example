# SentinelOps Linux Monitoring Agent Environment Configuration
# Place at /etc/sentinelops/agent.env with permissions 0600 owned by sentinelops:sentinelops

SENTINELOPS_API_URL=http://127.0.0.1:8000
SENTINELOPS_SERVER_ID=replace-with-server-uuid
SENTINELOPS_API_TOKEN=sops_replace-with-agent-token
SENTINELOPS_INTERVAL_SECONDS=5
SENTINELOPS_LOG_SOURCES=/var/log/syslog,/var/log/auth.log
SENTINELOPS_ENABLE_JOURNALCTL=true
SENTINELOPS_MAX_PROCESSES=30

